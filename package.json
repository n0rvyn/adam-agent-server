{
  "name": "adam-agent-server",
  "version": "1.19.1",
  "description": "Goal-driven AI agent orchestration server with Role+Skill model, real-time streaming, and multi-channel delivery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0rvyn/adam-agent-server.git"
  },
  "homepage": "https://github.com/n0rvyn/adam-agent-server#readme",
  "bugs": {
    "url": "https://github.com/n0rvyn/adam-agent-server/issues"
  },
  "author": "norvyn https://x.com/norvynzhang https://github.com/n0rvyn norvynzhang@gmail.com",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "web/dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:all": "tsup && cd web && pnpm build",
    "prepublishOnly": "pnpm build:all",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node scripts/run-vitest-groups.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude 'src/__tests__/e2e/**'",
    "pretest:unit": "tsx scripts/audit-test-db-isolation.ts",
    "pretest": "tsx scripts/audit-test-db-isolation.ts",
    "typecheck": "tsc --noEmit",
    "audit:tool-receipts": "tsx scripts/audit-tool-receipts.ts",
    "audit:test-isolation": "tsx scripts/audit-test-db-isolation.ts",
    "postinstall": "npm rebuild better-sqlite3 2>/dev/null || true"
  },
  "bin": {
    "adam": "dist/cli.js"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.26.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@anthropic-ai/sdk": "^0.80.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.2.0",
    "adm-zip": "^0.5.17",
    "ajv": "^8.20.0",
    "better-sqlite3": "^11.10.0",
    "bree": "^9.2.9",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.26.4",
    "fastify": "^5.8.5",
    "html-to-text": "^9.0.5",
    "image-size": "^2.0.2",
    "imapflow": "^1.3.3",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "mailparser": "^3.9.8",
    "markdown-it": "^14.1.1",
    "nodemailer": "^7.0.13",
    "onnxruntime-web": "^1.26.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "uuid": "^11.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.6",
    "conventional-commits-parser": "^3.2.4",
    "happy-dom": "^20.9.0",
    "ink-testing-library": "^4.0.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
