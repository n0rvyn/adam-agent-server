# ──────────────────────────────────────────────
# Adam Agent Server - Environment Variables
#
# This file is OPTIONAL. All settings can be configured via the Web UI (Settings page).
# Copy to ~/.adam/.env only if you prefer file-based initial config.
#
# Priority: DB (Settings UI) > .env file > inherited env vars > built-in defaults
# .env values seed the DB on first boot. After that, DB is the authority — UI changes take precedence.
#
# For testing, copy to .env.test and set ADAM_ENV_FILE=.env.test
# Full Claude Code env var reference: https://code.claude.com/docs/en/env-vars
# ──────────────────────────────────────────────

# ── Authentication ───────────────────────────
#
# Option A: Anthropic API key (direct)
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Option B: Subscription auth (Claude Max/Pro/Team)
#   Leave all auth vars unset; CLI uses session auth automatically.
#
# Option C: Anthropic-compatible third-party provider (DashScope, LiteLLM, OpenRouter, etc.)
#   ANTHROPIC_AUTH_TOKEN=<provider-auth-token>   # sent as Authorization: Bearer <value>
#   ANTHROPIC_BASE_URL=<provider-endpoint>       # e.g., https://coding.dashscope.aliyuncs.com/apps/anthropic
#
# Option D: Cloud providers
#   Bedrock:  CLAUDE_CODE_USE_BEDROCK=1  + AWS credentials
#   Vertex:   CLAUDE_CODE_USE_VERTEX=1   + GCP credentials
#   Foundry:  CLAUDE_CODE_USE_FOUNDRY=1  + ANTHROPIC_FOUNDRY_BASE_URL=...
#   See: https://code.claude.com/docs/en/amazon-bedrock
#        https://code.claude.com/docs/en/google-vertex-ai
#        https://code.claude.com/docs/en/microsoft-foundry
#
# Skip auth for LLM gateways:
#   CLAUDE_CODE_SKIP_BEDROCK_AUTH=1
#   CLAUDE_CODE_SKIP_VERTEX_AUTH=1
#   CLAUDE_CODE_SKIP_FOUNDRY_AUTH=1

ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# ── Model ────────────────────────────────────
# Primary model (alias or full name).
# Aliases: sonnet, opus, haiku
# Full names: claude-sonnet-4-6, claude-opus-4-6
# Third-party: use provider model name when ANTHROPIC_BASE_URL is set
ANTHROPIC_MODEL=

# Per-family model overrides (optional, full model names only)
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001

# Custom model for /model picker (gateway-specific model IDs)
# ANTHROPIC_CUSTOM_MODEL_OPTION=my-custom-model
# ANTHROPIC_CUSTOM_HEADERS="X-Custom: value"

# ── Server ───────────────────────────────────
# ADAM_PORT=7100
# ADAM_API_KEY=
# ADAM_DB_PATH=              # Default: ~/.adam/adam.db

# ── Proxy ────────────────────────────────────
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1
